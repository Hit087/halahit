  quantity    Int
  price       Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model Settings {
  id                String  @id @default("default")
  storeName         String  @default("Hit | هيت")
  tagline           String  @default("أكل قطعة ذكري")
  whatsappNumber    String  @default("966500000000")
  logo              String?
  mapLink           String?
  jahezLink         String?
  hungerStationLink String?
  toYouLink         String?
  tiktokLink        String?
  instagramLink     String?
  snapchatLink      String?
  kitalink          String?
  theChefzLink      String?
  adminPassword     String?
  heroSlides        Json    @default("[]")

  // ==== إضافات جديدة ====
  onlinePaymentEnabled     Boolean @default(false) // سويتش عام: تفعيل/تعطيل الدفع الإلكتروني بكل الموقع
  announcementScrolling    Boolean @default(true)  // شريط الإعلانات: متحرك (true) أو ثابت (false)
  commercialRegNumber      String? // رقم السجل التجاري (يدخله الأدمن يدويًا)
  commercialLicenseNumber  String? // رقم الرخصة (يدخله الأدمن يدويًا)
  commercialRegVisible     Boolean @default(false) // سويتش تفعيل/تعطيل عرض السجل والرخصة بالفوتر
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String?
  productId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([productId])
}

// ==================== جداول جديدة كاملة ====================

// طرق الاستلام/التوصيل — يديرها الأدمن بالكامل (إضافة/تعديل/حذف/تفعيل/تعطيل)
model FulfillmentMethod {
  id        String   @id @default(cuid())
  name      String   // مثال: "استلام من الفرع"، "توصيل عادي"
  type      String   // "PICKUP" أو "DELIVERY" — يحدد سلوك واجهة الدفع
  price     Decimal  @default(0) @db.Decimal(10, 2)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// طرق الدفع — يديرها الأدمن بالكامل (إضافة/تعديل/حذف/تفعيل/تعطيل)
model PaymentMethod {
  id        String   @id @default(cuid())
  name      String   // مثال: "الدفع عند الاستلام"، "بطاقة مدى/فيزا (ميسر)"
  type      String   // "CASH" أو "GATEWAY" — يحدد هل يوديه لبوابة دفع فعلية أو واتساب مباشرة
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// شريط الإعلانات العلوي — رسالة أو أكثر، يديرها الأدمن
model AnnouncementBar {
  id        String   @id @default(cuid())
  message   String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
